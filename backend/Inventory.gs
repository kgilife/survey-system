function syncInventoryFromSchema_(ss,schema){var sheet=ss.getSheetByName('庫存設定');if(!sheet)return;var old=rows_(sheet),map={};old.forEach(function(r){map[r.question_id+'|'+r.option_value]=r;});var next=[];(schema.questions||[]).filter(function(q){return q.type==='inventory';}).forEach(function(q){(q.options||[]).forEach(function(o){var key=q.id+'|'+o.value,prev=map[key],initial=Math.max(0,Number(o.stock||0)),remaining=prev?Number(prev.remaining_stock):initial;if(prev&&Number(prev.initial_stock)!==initial)remaining=Math.max(0,remaining+(initial-Number(prev.initial_stock)));next.push({question_id:q.id,option_value:o.value,initial_stock:initial,remaining_stock:remaining,active:true,updated_at:now_()});});});replaceAll_(sheet,next);}
function inventoryMap_(ss){var out={};rows_(ss.getSheetByName('庫存設定')).forEach(function(r){out[r.question_id+'|'+r.option_value]=r;});return out;}
function attachInventory_(ss,schema){var map=inventoryMap_(ss);schema.questions.filter(function(q){return q.type==='inventory';}).forEach(function(q){q.options.forEach(function(o){var r=map[q.id+'|'+o.value];o.remaining=r?Number(r.remaining_stock):0;});});return schema;}
function inventoryQuantities_(schema,answers){var out={};schema.questions.filter(function(q){return q.type==='inventory';}).forEach(function(q){var v=answers[q.id],quantities=v&&typeof v==='object'?v:{};(q.options||[]).forEach(function(o){out[q.id+'|'+o.value]={questionId:q.id,optionValue:o.value,quantity:Math.max(0,Number(quantities[o.value]||0))};});});return out;}
function applyInventory_(ss,account,schema,answers){var answerRows=rows_(ss.getSheetByName('使用者回答')),oldAnswers={};answerRows.filter(function(r){return r.account===account;}).forEach(function(r){oldAnswers[r.question_id]=parseJson_(r.answer_value,{});});var before=inventoryQuantities_(schema,oldAnswers),after=inventoryQuantities_(schema,answers),sheet=ss.getSheetByName('庫存設定'),stock=inventoryMap_(ss),changes=[];Object.keys(after).forEach(function(key){var delta=after[key].quantity-(before[key]?before[key].quantity:0),r=stock[key];if(!r)throw apiError_('INVENTORY','找不到庫存設定。');if(delta>Number(r.remaining_stock))throw apiError_('INVENTORY_SHORTAGE','選擇的名額已不足。',[{questionId:after[key].questionId,message:'剩餘名額不足，請重新選擇'}]);if(delta!==0)changes.push({key:key,row:r,item:after[key],delta:delta});});changes.forEach(function(c){var beforeQty=Number(c.row.remaining_stock),afterQty=beforeQty-c.delta;updateWhere_(sheet,function(r){return r.question_id===c.item.questionId&&r.option_value===c.item.optionValue;},{remaining_stock:afterQty,updated_at:now_()});append_(ss.getSheetByName('庫存異動紀錄'),{transaction_id:Utilities.getUuid(),account:account,question_id:c.item.questionId,option_value:c.item.optionValue,quantity_delta:-c.delta,before_quantity:beforeQty,after_quantity:afterQty,action:'submit',created_at:now_()});});}
